# ==============================================================================
# GitHub Description Generator - 環境設定ファイル例 (.env.example)
# 本ファイルをコピーして .env を作成し、実際の環境に合わせて値を設定してください。
# ※ 本番環境のシークレット値は絶対にGitリポジトリへコミットしないでください。
# ==============================================================================

# アプリケーション実行環境 (development | production)
APP_ENV=production

# サーバー待受設定 (Dockerコンテナ内では 0.0.0.0、ホスト側 compose.yaml で 127.0.0.1:8085 にバインド)
HOST=0.0.0.0
PORT=8085

# サブパス配信設定 (例: https://zyuuuukak1n.dev/tools/github-description/ で公開する場合に指定)
# ルート直下で公開する場合は空欄で構いません。
ROOT_PATH=/tools/github-description

# CORS許可オリジン (カンマ区切り。本番では実際のドメインを指定してください)
# 例: http://localhost:8085,https://zyuuuukak1n.dev
CORS_ORIGINS=*

# ログ出力レベル (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# レート制限設定 (1クライアントあたりの分間最大リクエスト数)
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# GitHub API設定 (任意)
# ------------------------------------------------------------------------------
# パブリックリポジトリの参照レート制限（未認証: 60回/時、認証済: 5,000回/時）を緩和するためのトークンです。
# 空欄でもパブリックリポジトリの解析は動作します。
# ※リポジトリのDescription更新には、ユーザーが画面から入力するPAT（Personal Access Token）が優先使用されます。
GITHUB_DEFAULT_TOKEN=

# ------------------------------------------------------------------------------
# AIモデル・LLM設定 (任意)
# ------------------------------------------------------------------------------
# APIキーが未設定の場合でも、組み込みのヒューリスティック自然言語抽出エンジンにより
# リポジトリ構造・README・依存関係から自動で高品質な説明文（350文字以内）を生成します。

# Google Gemini API を使用する場合:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API を使用する場合 (Geminiキーがない場合のフォールバック等):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
